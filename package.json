{
  "name": "@pascapone/dsh-task-master",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "DSH Task Master: live sessions, managed tasks and listening processes with honest ownership and guarded stop controls.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pascapone/dsh-task-master.git"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.fixtures.json --noEmit",
    "build": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build:fixtures": "tsc -p tsconfig.fixtures.json",
    "test": "pnpm run build && pnpm run build:fixtures && node test.ts && node client.test.ts && node scan.test.ts && node boundaries.test.ts",
    "check": "pnpm run typecheck && pnpm test"
  },
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-terminal-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-modules": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-terminal": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.7-rc.2",
    "@pascapone/dsh-dev-gateways": "file:vendor/pascapone-dsh-dev-gateways-0.1.4.tgz",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "typescript": "5.9.3"
  }
}
